// Microsoft Visual C++ generated resource script.
//
#include "resource.h"
/////////////////////////////////////////////////////////////////////////////
// English (United States) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
// 65001, not the 1252 the sample came with: the strings below are the ones
// the user sees, so they are Japanese. Under 1252 rc.exe encodes them
// byte-by-byte without complaining and the language bar shows mojibake.
#pragma code_page(65001)

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDIS_SAMPLEIME          ICON                    "image\\SampleIme.ico"
IDI_IME_MODE_ON         ICON                    "image\\ImeModeOn.ico"
IDI_IME_MODE_OFF        ICON                    "image\\ImeModeOff.ico"
IDI_DOUBLE_SINGLE_BYTE_ON ICON                    "image\\DoubleSingleByteOn.ico"
IDI_DOUBLE_SINGLE_BYTE_OFF ICON                    "image\\DoubleSingleByteOff.ico"
IDI_PUNCTUATION_ON      ICON                    "image\\PunctuationOn.ico"
IDI_PUNCTUATION_OFF     ICON                    "image\\PunctuationOff.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Version
//

// 1 is VS_VERSION_INFO, and the sample had this as IDR_VERSION2 (107).
// GetFileVersionInfo only ever looks at resource 1, so under the sample's id
// this block was invisible: the properties dialog showed a DLL with no version
// information at all, and every value below was dead weight.
//
// Written as the number rather than the VS_VERSION_INFO macro because this
// script includes only resource.h — the macro lives in the Windows headers, and
// rc.exe silently takes an unresolved name here as a *string* resource name
// instead of an id, which produces the same invisible block as before.
1 VERSIONINFO
 FILEVERSION 0,0,1,0
 PRODUCTVERSION 0,0,1,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            // Ohagey's identity, not the sample's. This block is what the file
            // properties dialog and any allow-listing tool read, and leaving it
            // saying MSFT would have a shipped Ohagey binary claiming to be
            // Microsoft sample code. Vendoring is recorded in tsf/README.md and
            // the licence, which is where attribution belongs (decisions
            // 0021 / 0022).
            VALUE "CompanyName", "Ohagey Contributors"
            VALUE "FileDescription", "Ohagey Japanese IME text service"
            VALUE "FileVersion", "0.0.1.0"
            VALUE "InternalName", "OhageyTSF.dll"
            VALUE "LegalCopyright", "Copyright (c) 2026 Ohagey Contributors. MIT licensed."
            VALUE "OriginalFilename", "OhageyTSF.dll"
            VALUE "ProductName", "Ohagey"
            VALUE "ProductVersion", "0.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


#ifdef APSTUDIO_INVOKED
/////////////////////////////////////////////////////////////////////////////
//
// TEXTINCLUDE
//

1 TEXTINCLUDE 
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE 
BEGIN
    "\0"
END

3 TEXTINCLUDE 
BEGIN
    "\r\n"
    "\0"
END

#endif    // APSTUDIO_INVOKED


/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE
BEGIN
    IDIS_SAMPLEIME          "おはぎー 日本語入力"
    IDS_DEFAULT_FONT        "Yu Gothic UI"
END

STRINGTABLE
BEGIN
// Not loaded by anything -- the text the language bar shows lives in
// Globals.cpp. These are kept in step so the two do not contradict each
// other.
    IDS_IME_MODE            "かな/英数の切り替え (Shift)"
    IDS_DOUBLE_SINGLE_BYTE  "全角/半角 (Shift+Space)"
    IDS_PUNCTUATION         "句読点の全角/半角 (Ctrl+.)"
END

#endif    // English (United States) resources
/////////////////////////////////////////////////////////////////////////////



#ifndef APSTUDIO_INVOKED
