<?xml version="1.0" encoding="utf-8"?>
<!--
  Builds the Swift engine as part of the C++ build (decision 0020).

  Two toolchains, one command: someone changing ohagey.proto has to rebuild both
  sides, and remembering that is not a good way to find out they forgot.

  ── Properties ──────────────────────────────────────────────────────────────

    OhageyBuildEngine       true (default) to build engine/ alongside the DLL.
                            Set false for a C++-only iteration.

    OhageyLlamaLibDir       Directory holding llama.lib, normally
                            <llama.cpp>\build-b4846\src\Release (decision 0028).
                            Optional: if LIB already points there — which is what
                            docs/local-setup.md tells you to do — leave it unset
                            and the linker finds it on its own.
                            Falls back to the OHAGEY_LLAMA_LIB_DIR environment
                            variable.

    OhageySwiftScratchPath  Passed to swift build as its scratch-path option. Needed when
                            the repository sits somewhere deep: the dependency
                            checkouts are long enough to hit the 260-character
                            limit (see docs/local-setup.md).

    OhageySwiftExe          Full path to swift.exe. Defaults to plain "swift",
                            found on PATH. Set it where PATH cannot be relied
                            on: MSBuild's Exec runs through cmd.exe, and on a
                            build agent whose PATH is already near the length
                            limit, entries appended late (which is where a
                            toolchain installed during the build lands) can be
                            missing by the time cmd sees them. That is exactly
                            what happened on the GitHub runner.

  Example:

    msbuild SampleIME.vcxproj /p:Configuration=Release /p:Platform=x64 ^
            /p:OhageyLlamaLibDir=C:\src\llama.cpp\build-b4846\src\Release
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <OhageyBuildEngine Condition="'$(OhageyBuildEngine)' == ''">true</OhageyBuildEngine>

    <!-- tsf/ -> repository root -> engine/ -->
    <OhageyEngineDirectory Condition="'$(OhageyEngineDirectory)' == ''">$(MSBuildThisFileDirectory)..\engine</OhageyEngineDirectory>

    <OhageyLlamaLibDir Condition="'$(OhageyLlamaLibDir)' == ''">$(OHAGEY_LLAMA_LIB_DIR)</OhageyLlamaLibDir>

    <OhageySwiftExe Condition="'$(OhageySwiftExe)' == ''">swift</OhageySwiftExe>

    <!-- MSBuild's Debug/Release, in the spelling SwiftPM wants. -->
    <OhageySwiftConfiguration Condition="'$(Configuration)' == 'Release'">release</OhageySwiftConfiguration>
    <OhageySwiftConfiguration Condition="'$(OhageySwiftConfiguration)' == ''">debug</OhageySwiftConfiguration>
  </PropertyGroup>

  <Target Name="OhageyBuildSwiftEngine"
          BeforeTargets="ClCompile"
          Condition="'$(OhageyBuildEngine)' == 'true'">

    <PropertyGroup>
      <_OhageySwiftArgs>build -c $(OhageySwiftConfiguration)</_OhageySwiftArgs>
      <_OhageySwiftArgs Condition="'$(OhageySwiftScratchPath)' != ''">$(_OhageySwiftArgs) --scratch-path "$(OhageySwiftScratchPath)"</_OhageySwiftArgs>
      <!-- Only when we were told where llama.lib is; otherwise LIB is expected
           to cover it, and passing an empty -L would be a linker error. -->
      <_OhageySwiftArgs Condition="'$(OhageyLlamaLibDir)' != ''">$(_OhageySwiftArgs) -Xlinker -L"$(OhageyLlamaLibDir)"</_OhageySwiftArgs>
    </PropertyGroup>

    <Message Importance="high"
             Text="Ohagey: building the Swift engine ($(OhageySwiftConfiguration))" />

    <!-- INCLUDE and EXTERNAL_INCLUDE are cleared for this call on purpose.
         They describe the C++ headers MSBuild picked for *this* project, and
         the Swift toolchain does not want them: its clang resolves the MSVC and
         Windows SDK headers through paths recorded when Swift was installed.
         When the two disagree the C module build fails in a way that names
         neither cause — on the CI runner INCLUDE pointed at MSVC 14.51 while
         Swift's clang used 14.44, and the result was

             dispatch/time.h: missing '#include <stdint.h>';
             'uint64_t' must be declared before it is used
             MSVC\14.44.35207\include\stdint.h: declaration here is not visible

         LIB is deliberately left alone: pointing it at llama.lib is what
         docs/local-setup.md tells people to do, and clearing it would break
         every local build that relies on that.

         No ContinueOnError: if the engine does not compile, a build that
         claimed to succeed would leave the DLL talking to a stale one.

         IgnoreStandardErrorWarningFormat stops MSBuild from re-reading swift's
         output and promoting lines to build warnings. Without it every build
         reports SwiftPM's symlink notice (harmless, and expected when Windows
         developer mode is off — see docs/local-setup.md) as a warning, and a
         warning that always fires is one nobody reads. The exit code still
         fails the build.

         `2>&1` and the high importance are what make a failure diagnosable.
         Compiler errors go to stderr, and IgnoreStandardErrorWarningFormat
         demotes stderr to a low-importance message — which `msbuild /v:minimal`
         (what CI uses) does not print. The result was a build that failed with
         MSB3073 and five minutes of silence in front of it: the exit code said
         the engine did not compile and nothing said why. Merging stderr into
         stdout and asking for high importance costs a few lines on a successful
         build and is the difference between a diagnosable failure and a guess. -->
    <Exec Command="&quot;$(OhageySwiftExe)&quot; $(_OhageySwiftArgs) 2>&amp;1"
          WorkingDirectory="$(OhageyEngineDirectory)"
          EnvironmentVariables="INCLUDE=;EXTERNAL_INCLUDE="
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="high" />
  </Target>

  <!-- Nothing to clean here: `swift package clean` would also throw away the
       resolved dependency checkouts, which take minutes to fetch again. -->
  <Target Name="OhageyCleanNotice" AfterTargets="Clean" Condition="'$(OhageyBuildEngine)' == 'true'">
    <Message Importance="normal"
             Text="Ohagey: engine build artifacts left alone; run `swift package clean` in engine/ to remove them." />
  </Target>

</Project>
