<Page
    x:Class="Ohagey.Settings.Pages.LearningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollView>
        <StackPanel Padding="32" Spacing="20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="学習" Style="{StaticResource TitleTextBlockStyle}" />

            <ToggleSwitch
                x:Name="LearningSwitch"
                Header="入力した内容から学習する"
                OnContent="オン" OffContent="オフ"
                Toggled="OnToggled" />
            <TextBlock
                Text="確定した候補を覚え、次回から選びやすくします。共有のパソコンでは切っておけます。"
                TextWrapping="Wrap"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <!-- On by default since the base language model ships
                 (decision 0034). It was off for a month because confirming
                 one phrase cost 15 to 18 of 30 otherwise-correct
                 conversions — which turned out to be how the personal model
                 was built, not the feature.

                 The bar below is informational rather than a warning: there
                 is no longer a trade to warn about, but the switch does
                 decide whether a readable record of what was typed exists on
                 disk, and that is worth saying where the switch is. -->
            <ToggleSwitch
                x:Name="PersonalizationSwitch"
                Header="学習をニューラル変換の候補順にも反映する"
                OnContent="オン" OffContent="オフ"
                Toggled="OnToggled" />
            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="確定した語が候補の上位に来ます"
                Message="オフにすると、確定した語句の控え(テキストファイル)も作られなくなります。共有のパソコンで気になる場合は切っておけます。" />
            <TextBlock
                x:Name="PersonalizationNote"
                TextWrapping="Wrap"
                Style="{StaticResource CaptionTextBlockStyle}" />

            <!-- The base language model is downloaded separately and can be
                 missing on its own (decision 0034). Without it the switch above
                 does nothing at all — not less, nothing — and there is no other
                 way for a user to tell that apart from "this feature is
                 useless". Severity is raised only when the switch is on and the
                 model is absent; a warning on a machine where everything is
                 fine would teach people to ignore this bar. -->
            <InfoBar
                x:Name="BaseModelNotice"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational" />

            <StackPanel Spacing="8">
                <TextBlock Text="反映の強さ" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <!-- Maximum is 150, matching SettingsSchema.MaximumAlphaPercent
                     and azooKey-Desktop's "hard". It said 100, which silently
                     capped the setting below what the schema allows and what
                     the engine would accept. -->
                <Slider
                    x:Name="AlphaSlider"
                    Minimum="0" Maximum="150"
                    StepFrequency="1"
                    Width="320"
                    HorizontalAlignment="Left"
                    ValueChanged="OnSliderChanged" />
                <TextBlock
                    Text="弱くすると関係のない語への影響は減りますが、100 未満では学習した語も上がらなくなります。"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <!-- Zero looks like "off" and is not (decision 0035's open
                     item). The mixing term becomes zero, so the ranking is
                     untouched — but personalisation is still switched on, so
                     committed phrases keep being written to
                     personal/corpus.txt in plain text. Someone who dragged the
                     slider to the left to stop that has not stopped it.

                     The schema still allows 0. Raising the minimum instead
                     would silently clamp an existing user's deliberate 0 up
                     into the effective range on their next update, which is
                     the failure decision 0035 exists to prevent. So the value
                     stays legal and the page says what it does. -->
                <InfoBar
                    x:Name="AlphaZeroNotice"
                    IsOpen="False"
                    IsClosable="False"
                    Severity="Informational"
                    Title="0 では候補順に効きません"
                    Message="ただし個人化はオンのままなので、確定した語句の控えは作られ続けます。完全に止めるには上のスイッチをオフにしてください。" />
            </StackPanel>

            <!-- Decision 0037. The personal model is trained on a few thousand
                 characters of committed phrases while the base it is
                 subtracted from is trained on over a million, and that gap is
                 what limits how much personalisation can do. azooKey's own
                 Tuner closes it by collecting text across applications, which
                 decisions 0016 and 0025 rule out here — so the user hands over
                 a file instead.

                 Placed above the erase section on purpose: the two are
                 adjacent in a user's mind ("what does Ohagey have of mine?")
                 and the erase button deliberately does not take this. -->
            <StackPanel Spacing="8">
                <TextBlock Text="文章を取り込む" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Text="よく書く文章のテキストファイルを読み込ませると、その言い回しが候補の上位に出やすくなります。取り込んだ内容が外部に送信されることはありません。"
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock x:Name="ImportSummary" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ImportButton" Content="テキストファイルを選ぶ" Click="OnImportClicked" />
                    <Button x:Name="ClearImportButton" Content="取り込んだ文章を削除" Click="OnClearImportClicked" />
                </StackPanel>
                <InfoBar x:Name="ImportResultBar" IsOpen="False" IsClosable="True" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="学習データの消去" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="EraseSummary" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                <Button x:Name="EraseButton" Content="学習データを消去" Click="OnEraseClicked" />
                <InfoBar x:Name="EraseResultBar" IsOpen="False" IsClosable="True" />
            </StackPanel>
        </StackPanel>
    </ScrollView>
</Page>
